<Window x:Class="VtuberHubStudio.ModelViewer.ModelViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3D模型预览" Height="720" Width="1200" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部工具栏：核心操作 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="BtnOpen" Content="打开模型" Width="90" Margin="4"/>
                <Button x:Name="BtnReset" Content="重置视图" Width="90" Margin="4"/>
                <Button x:Name="BtnNewAvatar" Content="新建人物" Width="90" Margin="4"/>
                <ToggleButton x:Name="ToggleSkeleton" Content="显示骨架" IsChecked="True" Margin="6,0"/>
                <Separator/>
                <Button x:Name="BtnExport" Content="导出OBJ" Width="90" Margin="6,0"/>
                <!-- 新增：素材列表下拉框与刷新按钮 -->
                <Separator/>
                <TextBlock Text="素材列表" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="CbAssets" Width="260" Margin="4"/>
                <Button x:Name="BtnRefreshAssets" Content="刷新" Width="60" Margin="4"/>
            </ToolBar>
        </ToolBarTray>

        <!-- 左侧操作面板：分门别类参数 -->
        <Border DockPanel.Dock="Left" Width="340" Background="#F7F7F8" BorderBrush="#DDDDDD" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="操作面板" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                    <Expander Header="外观与体型" IsExpanded="True" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="皮肤" VerticalAlignment="Center" Width="60"/>
                                <ComboBox x:Name="CbSkin" Width="180" SelectedIndex="1">
                                    <ComboBoxItem Content="浅肤"/>
                                    <ComboBoxItem Content="自然"/>
                                    <ComboBoxItem Content="中肤"/>
                                    <ComboBoxItem Content="深肤"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="衣服颜色" VerticalAlignment="Center" Width="80"/>
                                <ComboBox x:Name="CbCloth" Width="160" SelectedIndex="1">
                                    <ComboBoxItem Content="白"/>
                                    <ComboBoxItem Content="黑"/>
                                    <ComboBoxItem Content="蓝"/>
                                    <ComboBoxItem Content="红"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="眼睛" VerticalAlignment="Center" Width="60"/>
                                <ComboBox x:Name="CbEye" Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="黑"/>
                                    <ComboBoxItem Content="棕"/>
                                    <ComboBoxItem Content="蓝"/>
                                    <ComboBoxItem Content="绿"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="头发" VerticalAlignment="Center" Width="60"/>
                                <ComboBox x:Name="CbHair" Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="黑"/>
                                    <ComboBoxItem Content="棕"/>
                                    <ComboBoxItem Content="金"/>
                                    <ComboBoxItem Content="灰"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="高光" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="ShininessSlider" Minimum="2" Maximum="64" Value="16" Width="180"/>
                            </StackPanel>
                            <Separator Margin="0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="身高" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="HeightSlider" Minimum="1.4" Maximum="2.1" Value="1.7" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="躯干粗" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="BodyRadiusSlider" Minimum="0.12" Maximum="0.30" Value="0.20" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="四肢粗" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="LimbRadiusSlider" Minimum="0.05" Maximum="0.15" Value="0.08" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="肩宽" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="ShoulderScaleSlider" Minimum="0.8" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="腰围" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="WaistScaleSlider" Minimum="0.8" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="臀部" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="HipScaleSlider" Minimum="0.8" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="前臂长" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="ForearmScaleSlider" Minimum="0.7" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="小腿长" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="ShinScaleSlider" Minimum="0.7" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="头大小" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="HeadScaleSlider" Minimum="0.8" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>

                            <Separator Margin="0,8"/>
                            <TextBlock Text="面部与肢端细节" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="鼻子大小" VerticalAlignment="Center" Width="70"/>
                                <Slider x:Name="NoseSizeSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="170"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="嘴宽" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="MouthWidthSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="耳朵大小" VerticalAlignment="Center" Width="70"/>
                                <Slider x:Name="EarSizeSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="170"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="手指长" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="FingerLengthSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="手指粗" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="FingerThicknessSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="脚长" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="FootLengthSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="脚宽" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="FootWidthSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="180"/>
                            </StackPanel>
                            <!-- 新增：眼睑/脚趾与面部高级参数 -->
                            <Separator Margin="0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <CheckBox x:Name="ChkEyelids" Content="启用眼睑" IsChecked="True" Width="120"/>
                                <TextBlock Text="大小" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <Slider x:Name="EyelidSizeSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="120"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <CheckBox x:Name="ChkToes" Content="启用脚趾" IsChecked="True" Width="120"/>
                                <TextBlock Text="趾长" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <Slider x:Name="ToeLengthSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="100"/>
                                <TextBlock Text="趾粗" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <Slider x:Name="ToeThicknessSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="100"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="眼距" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="EyeSeparationSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="虹膜" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="IrisRadiusSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="瞳孔" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="PupilRadiusSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="眉厚" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="BrowThicknessSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="眉长" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="BrowLengthSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="唇厚" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="LipThicknessSlider" Minimum="0.6" Maximum="1.6" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="耳角度" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="EarAngleSlider" Minimum="-30" Maximum="30" Value="0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="下巴" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="ChinSizeSlider" Minimum="0.7" Maximum="1.5" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="头宽" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="HeadWidthScaleSlider" Minimum="0.8" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="头高" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="HeadHeightScaleSlider" Minimum="0.8" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="头深" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="HeadDepthScaleSlider" Minimum="0.8" Maximum="1.3" Value="1.0" Width="180"/>
                            </StackPanel>
                            <!-- 新增参数控件结束 -->
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="服装风格" VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbClothingStyle" Width="180" SelectedIndex="0">
                                    <ComboBoxItem Content="西装"/>
                                    <ComboBoxItem Content="T恤"/>
                                    <ComboBoxItem Content="夹克"/>
                                    <ComboBoxItem Content="裙装"/>
                                    <ComboBoxItem Content="无"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="服装纹理" VerticalAlignment="Center" Width="70"/>
                                <Button x:Name="BtnSuitTexture" Content="选择服装纹理" Width="180"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="背景与视图" IsExpanded="False" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="背景" VerticalAlignment="Center" Width="60"/>
                                <ComboBox x:Name="CbBackground" Width="180" SelectedIndex="1">
                                    <ComboBoxItem Content="深灰"/>
                                    <ComboBoxItem Content="黑色"/>
                                    <ComboBoxItem Content="白色"/>
                                    <ComboBoxItem Content="蓝色"/>
                                    <ComboBoxItem Content="绿色"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="主光" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="LightIntensity" Minimum="0.1" Maximum="2.5" Value="1.0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="环境光" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="AmbientIntensity" Minimum="0.0" Maximum="3.0" Value="0.6" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="辅光" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="FillIntensity" Minimum="0.0" Maximum="3.0" Value="0.8" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="渲染预设" VerticalAlignment="Center" Width="70"/>
                                <ComboBox x:Name="CbRenderPreset" Width="170" SelectedIndex="0">
                                    <ComboBoxItem Content="默认"/>
                                    <ComboBoxItem Content="摄影棚"/>
                                    <ComboBoxItem Content="户外晴天"/>
                                    <ComboBoxItem Content="高对比"/>
                                    <ComboBoxItem Content="柔光"/>
                                </ComboBox>
                                <Button x:Name="BtnRestoreRender" Content="恢复默认" Margin="8,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="缩放" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="ScaleSlider" Minimum="0.1" Maximum="5" Value="1" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Yaw" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="YawSlider" Minimum="-180" Maximum="180" Value="0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Pitch" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="PitchSlider" Minimum="-180" Maximum="180" Value="0" Width="180"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="Roll" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="RollSlider" Minimum="-180" Maximum="180" Value="0" Width="180"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- 新增：导入模型基础变形控件（鼻子/耳朵缩放） -->
                    <Expander Header="导入模型变形" IsExpanded="True" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="鼻子大小" VerticalAlignment="Center" Width="70"/>
                                <Slider x:Name="ImportedNoseScale" Minimum="0.6" Maximum="1.6" Value="1.0" Width="170"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="耳朵大小" VerticalAlignment="Center" Width="70"/>
                                <Slider x:Name="ImportedEarScale" Minimum="0.6" Maximum="1.6" Value="1.0" Width="170"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="简单场景" IsExpanded="False" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <CheckBox x:Name="ToggleGround" Content="显示地面网格" IsChecked="True" Margin="0,4"/>
                            <CheckBox x:Name="ToggleBackdrop" Content="显示背景墙" IsChecked="True" Margin="0,4"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="姿态与关节" IsExpanded="False" Margin="0,0,0,8">
                        <StackPanel Margin="8">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="关节" VerticalAlignment="Center" Width="60"/>
                                <ComboBox x:Name="CbJoint" Width="180">
                                    <ComboBoxItem Content="左上臂"/>
                                    <ComboBoxItem Content="左前臂"/>
                                    <ComboBoxItem Content="右上臂"/>
                                    <ComboBoxItem Content="右前臂"/>
                                    <ComboBoxItem Content="左大腿"/>
                                    <ComboBoxItem Content="左小腿"/>
                                    <ComboBoxItem Content="右大腿"/>
                                    <ComboBoxItem Content="右小腿"/>
                                    <ComboBoxItem Content="头部"/>
                                    <ComboBoxItem Content="胸部"/>
                                    <ComboBoxItem Content="脊柱"/>
                                    <ComboBoxItem Content="臀部"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="角度" VerticalAlignment="Center" Width="60"/>
                                <Slider x:Name="JointAngleSlider" Minimum="-120" Maximum="120" Value="0" Width="180"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 主视口：使用原生 WPF Viewport3D -->
        <Grid x:Name="ViewportContainer">
            <Viewport3D x:Name="Viewport">
                <!-- 灯光组：略增强环境光，并加入填充光 -->
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <Model3DGroup>
                            <AmbientLight x:Name="Ambient" Color="#606060"/>
                            <DirectionalLight x:Name="Sun" Color="#FFFFFF" Direction="-1,-1,-2"/>
                            <DirectionalLight x:Name="FillLight" Color="#808080" Direction="1,0,-1"/>
                        </Model3DGroup>
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <!-- 场景与骨架根节点 -->
                <ModelVisual3D x:Name="SceneExtrasRoot"/>
                <ModelVisual3D x:Name="SceneRoot"/>
                <ModelVisual3D x:Name="SkeletonRoot"/>
            </Viewport3D>
        </Grid>
    </DockPanel>
</Window>