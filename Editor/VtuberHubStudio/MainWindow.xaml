<Window x:Class="VtuberHubStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="VtuberHub Studio" Height="700" Width="1100" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- 顶部菜单栏 -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="文件">
                <MenuItem Header="打开模型..." x:Name="MenuOpenModel"/>
                <Separator/>
                <MenuItem Header="退出" x:Name="MenuExit"/>
            </MenuItem>
            <MenuItem Header="摄像头">
                <MenuItem Header="开始" x:Name="MenuCamStart"/>
                <MenuItem Header="停止" x:Name="MenuCamStop"/>
            </MenuItem>
            <MenuItem Header="Mediapipe">
                <MenuItem Header="启用处理" x:Name="MenuEnableMediapipe"/>
                <MenuItem Header="显示叠加" x:Name="MenuShowOverlay"/>
            </MenuItem>
            <MenuItem Header="视图">
                <MenuItem Header="浅色主题" x:Name="MenuLightTheme"/>
                <MenuItem Header="深色主题" x:Name="MenuDarkTheme"/>
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" x:Name="MenuAbout"/>
            </MenuItem>
        </Menu>

        <!-- 操作栏 -->
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="开始摄像头" x:Name="TbStart" Margin="2"/>
                <Button Content="停止摄像头" x:Name="TbStop" Margin="2"/>
                <Separator/>
                <Button Content="打开3D窗口" x:Name="TbOpen3D" Margin="2"/>
                <Separator/>
                <TextBlock Text="设备" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="TbDeviceCombo" Width="160" Margin="2"/>
                <Button Content="刷新" x:Name="TbRefreshDevices" Margin="2"/>
                <Separator/>
                <TextBlock Text="分辨率" VerticalAlignment="Center" Margin="4,0"/>
                <ComboBox x:Name="ResolutionCombo" Width="120" Margin="2">
                    <ComboBoxItem Content="自动" IsSelected="True"/>
                    <ComboBoxItem Content="1280x720"/>
                    <ComboBoxItem Content="640x480"/>
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <!-- 主体：左侧操作区 + 右侧监视窗口；资源面板在左下角，不覆盖右侧画面 -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：Mediapipe 操作面板（上方） -->
            <Border Grid.Row="0" Grid.Column="0" Margin="8" BorderBrush="#444" BorderThickness="1" Background="#f5f5f5" CornerRadius="4">
                <StackPanel Margin="12">
                    <TextBlock Text="Mediapipe" FontWeight="Bold" FontSize="14"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button x:Name="MpEnable" Content="启用" Width="80" Margin="0,0,8,0"/>
                        <Button x:Name="MpDisable" Content="停止" Width="80"/>
                    </StackPanel>
                    <TextBlock x:Name="MpStatus" Text="状态：未初始化" Margin="0,8,0,0"/>
                    <Separator Margin="0,8,0,8"/>
                    <CheckBox x:Name="MpShowOverlay" Content="显示叠加" IsChecked="True"/>
                    <CheckBox x:Name="MpFlip" Content="水平翻转"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="叠加颜色：" VerticalAlignment="Center"/>
                        <ComboBox x:Name="MpOverlayColor" Width="140" Margin="6,0,0,0">
                            <ComboBoxItem Content="绿色" IsSelected="True"/>
                            <ComboBoxItem Content="红色"/>
                            <ComboBoxItem Content="蓝色"/>
                            <ComboBoxItem Content="黄色"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="线宽：" VerticalAlignment="Center"/>
                        <Slider x:Name="MpOverlayThickness" Minimum="1" Maximum="5" Value="2" Width="140" Margin="6,0,0,0"/>
                    </StackPanel>

                    <Separator Margin="0,12,0,8"/>
                    <TextBlock Text="高级设置" FontWeight="Bold" FontSize="14"/>
                    <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="后端：" Width="64" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AdvBackend" Width="160">
                                <ComboBoxItem Content="自动" IsSelected="True"/>
                                <ComboBoxItem Content="DSHOW"/>
                                <ComboBoxItem Content="MSMF"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="编码：" Width="64" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AdvCodec" Width="160">
                                <ComboBoxItem Content="自动" IsSelected="True"/>
                                <ComboBoxItem Content="MJPG"/>
                                <ComboBoxItem Content="YUY2"/>
                                <ComboBoxItem Content="H264"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="分辨率：" Width="64" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AdvResolution" Width="160">
                                <ComboBoxItem Content="自动" IsSelected="True"/>
                                <ComboBoxItem Content="640x480"/>
                                <ComboBoxItem Content="1280x720"/>
                                <ComboBoxItem Content="1920x1080"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="FPS：" Width="64" VerticalAlignment="Center"/>
                            <ComboBox x:Name="AdvFps" Width="160">
                                <ComboBoxItem Content="自动" IsSelected="True"/>
                                <ComboBoxItem Content="30"/>
                                <ComboBoxItem Content="60"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="AdvApply" Content="应用" Width="80"/>
                            <TextBlock x:Name="AdvHint" Margin="8,4,0,0" Foreground="#666" Text="修改需重启摄像头"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 左侧：资源监控面板（操作区下方，窗口左下角） -->
            <Border Grid.Row="1" Grid.Column="0" Margin="8,0,8,8" Background="#1a1a1a" BorderBrush="#333" BorderThickness="1" CornerRadius="4">
                <StackPanel Orientation="Vertical" Margin="8">
                    <ProgressBar x:Name="OverlayProgressBar" Height="10" Minimum="0" Maximum="100"/>
                    <TextBlock x:Name="OverlayProgressText" Foreground="#EEE" FontSize="12" Margin="0,4,0,0" Text="准备就绪"/>
                    <TextBlock x:Name="OverlayResourceText" Foreground="#AAA" FontSize="12" Margin="0,2,0,0" Text="CPU: 0%  Mem: 0MB"/>
                </StackPanel>
            </Border>

            <!-- 右侧：监视窗口，跨两行，占满右侧，不被资源面板覆盖 -->
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="8" BorderBrush="#444" BorderThickness="1" Background="#111" CornerRadius="4">
                <Grid>
                    <Image x:Name="MonitorImage" Stretch="Uniform"/>
                    <TextBlock x:Name="OverlayFps" HorizontalAlignment="Left" VerticalAlignment="Top"
                               Margin="12" Foreground="White" FontSize="14" Text="FPS: 0"/>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
